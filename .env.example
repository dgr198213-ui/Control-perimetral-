# Nunca guardes este archivo con secretos reales en Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MQTT_HOST=mosquitto
MQTT_PORT=1883
NOTIFY_ZONES=zona_perimetro
LOG_LEVEL=INFO
# 127.0.0.1 limita el dashboard a la propia máquina.
# Para acceso desde la LAN, usa la IP LAN del mini-PC y aplica firewall.
DASHBOARD_BIND_ADDRESS=127.0.0.1
