# Nunca guardes este archivo con secretos reales en Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MQTT_HOST=mosquitto
MQTT_PORT=1883
NOTIFY_ZONES=zona_perimetro
# Rutas internas; Compose las monta en volúmenes persistentes.
MULTISENSOR_DB=/data/multisensor.sqlite3
ACTIONS_DB=/data/actions.sqlite3
LOG_LEVEL=INFO
# Genera una clave Fernet local y guárdala solo en .env; nunca la subas a Git.
CONTROL_API_ENCRYPTION_KEY=
# Caddy limita el acceso al dashboard y a la API publicada.
# Debe coincidir con el nombre usado en el navegador para validar el certificado local.
CADDY_HOSTNAME=localhost
# Para acceso desde la LAN, usa la IP LAN del mini-PC y aplica firewall.
CADDY_BIND_ADDRESS=127.0.0.1
